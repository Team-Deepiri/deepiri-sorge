# Sorge Environment Variables
# Copy this to .env and fill in your values

# REQUIRED

# Required for Gemini (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# OPTIONAL

# Optional: token for posting review comments to GitHub
GITHUB_TOKEN=

# Optional: Override review mode (auto, cpu, gpu, gemini, openrouter, groq, skip)
# SORGE_MODE=auto

# Optional: Override config path
# SORGE_CONFIG=sorge.toml