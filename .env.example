# Sorge Environment Variables
# Copy this to .env and fill in your values

# REQUIRED

# Required for GitHub Models (get from GitHub Settings → Developer settings → Personal access tokens)
GITHUB_TOKEN=

# Required for Gemini (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# OPTIONAL

# Optional: Override review mode (auto, cpu, gpu, github, gemini, skip)
# SORGE_MODE=auto

# Optional: Override config path
# SORGE_CONFIG=sorge.toml