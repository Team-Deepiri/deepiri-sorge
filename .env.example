# Sorge Environment Variables
# Copy this to .env and fill in your values

# REQUIRED (at least one provider for non-skip reviews)

# Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL

# Token for posting review comments to GitHub
GITHUB_TOKEN=

# Override review mode (auto, gemini, openrouter, groq, skip)
# SORGE_MODE=auto

# Override config path
# SORGE_CONFIG=sorge.toml
